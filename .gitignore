# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package manager / local installs
frontend/node_modules/
backend/node_modules/

# testing
coverage/

# next.js
/.next/
/out/

# frontend build outputs
dist/
dist-ssr/

# production
build/

